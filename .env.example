# Public deployment. Do not put real secrets in this file or commit .env.
APP_URL=https://evals.alhena.ai
ADMIN_EMAIL=ashu@alhena.ai
MAIL_FROM=Comparison Lab <reports@alhena.ai>
MAIL_TRANSPORT=sendgrid
SENDGRID_API_KEY=
# Optional alternative: MAIL_TRANSPORT=resend with RESEND_API_KEY.
RESEND_API_KEY=
WORKER_SECRET=
# Optional until enabling the worker profile. Choose openai, anthropic or claude-cli explicitly.
MODEL_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Explicit, separately configured judge and auditor runs. Use models available to your API account.
JUDGE_MODEL=
AUDITOR_MODEL=
# Claude CLI only: use compose.claude.yml last. This is a separate transport secret,
# not the Claude token. Mount a token-only secret file into the judge container only.
JUDGE_SERVICE_SECRET=
CLAUDE_TOKEN_FILE=./.secrets/claude_oauth_token
DATA_DIR=./data
# Local development only: APP_URL=http://127.0.0.1:3100 and MAIL_TRANSPORT=file.
